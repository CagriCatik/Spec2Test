# Copy this file to .env and fill in your key. .env is git-ignored.
#
#   cp .env.example .env
#   $EDITOR .env
#
# The key is read from the environment at request time. It is never written to
# config.yml, never logged, and sent only to the configured cloud host.
# An already exported OLLAMA_API_KEY takes precedence over this file.
#
# Create a key at https://ollama.com -> Settings -> Keys
OLLAMA_API_KEY=

# Optional: override the cloud host (defaults to https://ollama.com)
#SPEC2TEST_LIVE_HOST=
# Optional: switches for the opt-in live test
#SPEC2TEST_LIVE=1
#SPEC2TEST_LIVE_MODE=ollama_cloud
#SPEC2TEST_LIVE_MODEL=gpt-oss:120b
